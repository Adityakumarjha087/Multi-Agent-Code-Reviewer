# Copy to .env and fill in. Docker Compose hands each service only the variables it needs.

# --- Required for reviews and the benchmark -------------------------------------------------
ANTHROPIC_API_KEY=

# --- GitHub ---------------------------------------------------------------------------------
# Read-only fine-grained token (Contents: read, Pull requests: read). Optional for public repos,
# but unauthenticated GitHub API calls are limited to 60 per hour.
GITHUB_READ_TOKEN=
# Write token (Pull requests: read & write), limited to the repositories you review.
# Only the publisher and the github_write MCP server ever receive it.
GITHUB_WRITE_TOKEN=

# --- Langfuse tracing (optional; tracing is off when keys are empty) ------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Database -------------------------------------------------------------------------------
# Local (non-Compose) runs; Compose builds its own URL from POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://prreview:prreview@127.0.0.1:5432/prreview
POSTGRES_PASSWORD=prreview

# --- Models and limits (defaults shown) -----------------------------------------------------
# LLM_PLANNER_MODEL=claude-opus-5-5
# LLM_BUG_MODEL=claude-opus-5-5
# LLM_SECURITY_MODEL=claude-opus-5-5
# LLM_TEST_MODEL=claude-opus-5-5
# LLM_AGGREGATOR_MODEL=claude-opus-5-5
# LLM_EFFORT=high
# LIMIT_AGENT_MAX_STEPS=12
# LIMIT_GRAPH_RECURSION_LIMIT=40
# LIMIT_REVIEW_MAX_COST_USD=2.0
# SANDBOX_RUN_TIMEOUT_S=300
# SANDBOX_MEMORY_MB=1024
